# Copy to backend/.env (git-ignored) and fill in. Needed only for SMS and USSD.
# Africa's Talking sandbox: free, messages go to their phone simulator.
AT_USERNAME=sandbox
AT_API_KEY=your-sandbox-api-key
# The phone that receives SMS and holds the demo policy on USSD (international format).
AT_PHONE=+2507XXXXXXXX

# Optional
# AT_POLICY=RDI-RWA-1233     # the demo policy the phone above holds
# AT_DAILY_LIMIT=20          # live mode only: most SMS a day
# AT_SENDER_ID=YourName      # live mode only: an approved sender ID
